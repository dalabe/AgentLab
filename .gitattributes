# Normalize line endings to LF in the repository and working tree (matches .editorconfig).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Mock documents are data: keep them byte-exact (the seeder records their size).
mock-data/** -text

# Binary
*.ico binary
*.png binary
*.jpg binary
*.pfx binary

# Generated code: collapse in GitHub diffs and exclude from language stats.
src/Procesos.Data/Migrations/** linguist-generated=true
**/package-lock.json linguist-generated=true -diff
