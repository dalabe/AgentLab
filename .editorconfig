root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ts,html,css,scss,json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# ---- Analyzer severity overrides (see ADR-0015) ----
# High-performance logging (LoggerMessage source generators) is not required for an educational lab;
# keep the hints visible in the IDE but do not fail CI on them.
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

# EF Core migrations are generated code.
[src/Procesos.Data/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
