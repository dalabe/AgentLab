{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "Jwt": {
      "Issuer": "procesos-token-service",
      "Audience": "procesos-mcp-server",
      "AccessTokenLifetimeMinutes": 5
      // "SigningKey" se configura con `dotnet user-secrets set "Security:Jwt:SigningKey" "<valor>"`
      // (mismo valor que en Procesos.McpServer). Ver docs/RUNBOOK.md. Nunca en este archivo.
    },
    "RegisteredClients": {
      "Clients": [
        {
          "ClientId": "chatapi-client",
          "AllowedScopes": ["mcp.tools.invoke"]
          // "ClientSecret" se configura con
          // `dotnet user-secrets set "Security:RegisteredClients:Clients:0:ClientSecret" "<valor>"`
        }
      ]
    }
  }
}
