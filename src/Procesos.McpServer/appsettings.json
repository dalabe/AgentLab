{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ProcesosDb": "Server=(localdb)\\MSSQLLocalDB;Database=ProcesosLegalesLab;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Security": {
    "Jwt": {
      "Issuer": "procesos-token-service",
      "Audience": "procesos-mcp-server",
      "AccessTokenLifetimeMinutes": 5
      // "SigningKey" se configura con `dotnet user-secrets set "Security:Jwt:SigningKey" "<valor>"`
      // (debe ser idéntico al configurado en Procesos.TokenService). Ver docs/RUNBOOK.md.
    }
  }
}
