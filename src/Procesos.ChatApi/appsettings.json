{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Chat": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Llm": {
    "Provider": "Mock",
    "Anthropic": {
      "Model": "claude-sonnet-5",
      "MaxOutputTokens": 1500
      // "ApiKey" se configura con `dotnet user-secrets set "Llm:Anthropic:ApiKey" "<valor>"`.
      // Mientras no se configure, Provider se queda en "Mock" (funciona sin API key).
      // Para usar Claude real, configure la API key y cambie "Provider" a "Anthropic".
    }
  },
  "Mcp": {
    "Server": {
      "Endpoint": "http://localhost:5071/"
    }
  },
  "Security": {
    "ServiceClient": {
      "TokenEndpoint": "http://localhost:5061/connect/token",
      "ClientId": "chatapi-client",
      "Scope": "mcp.tools.invoke"
      // "ClientSecret" se configura con
      // `dotnet user-secrets set "Security:ServiceClient:ClientSecret" "<valor>"` (ya generado).
    }
  }
}
